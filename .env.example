# Copie este arquivo para .env e preencha os valores localmente.
# A chave NUNCA vai para o código nem para o git (.env está no .gitignore).
LLM_API_KEY=
# Provedor de LLM: openai ou anthropic
LLM_PROVEDOR=openai
# Modelo do projeto. Use o MESMO em todos os computadores: a versão do modelo é
# um parâmetro da pesquisa (congela junto com a regra), e trocar muda os resultados.
# Com anthropic, apague esta linha para usar o padrão (claude-opus-5-5).
LLM_MODELO=gpt-4.1-2025-04-14
# Destino opcional dos backups. Se vazio, usa OneDrive detectado no Windows;
# sem OneDrive, usa ../quant-backups e a interface avisa que o backup fica no mesmo disco.
# QUANT_BACKUP_DIR=D:\Backups\QUANT
# Alertas no celular quando a regra registrar uma compra ou venda (opcionais).
# ntfy (sem cadastro): instale o app ntfy, assine um tópico com nome difícil de adivinhar
# e ponha o mesmo nome aqui. Quem souber o nome do tópico lê os alertas.
# QUANT_NTFY_TOPICO=quant-um-nome-dificil-123
# Telegram: bot criado no @BotFather e o id da sua conversa com ele.
# QUANT_TELEGRAM_TOKEN=
# QUANT_TELEGRAM_CHAT=
# Só avisar das ações que você tem (a página Minhas ações gera a lista):
# QUANT_ALERTAS_TICKERS=PETR4,ITUB4
